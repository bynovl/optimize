{
  "name": "@bynovl/optimize-sources",
  "version": "2.2.6",
  "description": "Source validation submodule for the NOVL Optimize project. Checks HTML for external and internal source references, script and stylesheet integrity, and best practices for static sites.",
  "main": "index.js",
  "private": false,
  "bin": {
    "optimize-sources": "bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bynovl/optimize"
  },
  "author": "bynovl",
  "license": "SEE LICENSE IN ../../LICENSE",
  "keywords": [
    "sources",
    "source-validation",
    "external-sources",
    "internal-sources",
    "scripts",
    "stylesheets",
    "integrity",
    "static-site",
    "validation",
    "novl",
    "optimize"
  ],
  "type": "module",
  "dependencies": {
    "@bynovl/optimize-utils": "workspace:*",
    "@bynovl/optimize-lib": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
