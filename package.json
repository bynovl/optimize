{
  "author": "NOVL",
  "name": "@bynovl/optimize",
  "version": "1.0.0",
  "description": "Automate accessibility, SEO, GEO and best practice checks for any static site—configurable, extensible, and compatible with all static site generators.",
  "repository": {
    "type": "git",
    "url": "https://github.com/bynovl/optimize"
  },
  "homepage": "https://github.com/bynovl/optimize-priv#readme",
  "bugs": {
    "url": "https://github.com/bynovl/optimize-priv/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "optimization",
    "static-site",
    "seo",
    "accessibility",
    "validator",
    "best-practices",
    "open-graph",
    "schema",
    "meta-tags",
    "links",
    "images",
    "assets",
    "html",
    "eleventy",
    "gatsby",
    "nextjs",
    "nuxt",
    "jekyll",
    "hugo",
    "sapper",
    "astro",
    "vuepress",
    "jamstack",
    "ssg",
    "ci",
    "cd",
    "ci/cd"
  ],
  "main": "index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "optimize": "node ./packages/optimize-core/bin/cli.js",
    "optimize:debug": "DEBUG=true node ./packages/optimize-core/bin/cli.js",
    "lint": "eslint . --ext .js",
    "changeset": "changeset",
    "version": "changeset version",
    "release": ". ./automate/version-bump.sh",
    "publish": "changeset publish",
    "serve": "node server.js"
  },
  "license": "ISC",
  "dependencies": {
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "eslint": "^9.38.0"
  }
}
