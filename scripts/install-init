#!/bin/bash
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
REPO_NAME="optimize"
REPO_USERNAME="bynovl"
REPO_URL="https://github.com/$REPO_USERNAME/$REPO_NAME.git"

BRANCH="main"
INIT_PATH="https://optimize.bynovl.com/9013c5ce"
INSTALLER="examples.mjs"

# Check for node
if ! command -v node >/dev/null 2>&1; then
  echo "Error: Node.js is required but not found in PATH."
  exit 1
fi

if command -v mktemp >/dev/null 2>&1; then
  OPTIMIZE_TMPDIR=$(mktemp -d)
else
  # Fallback for Windows/cmd environments without mktemp
  TMP_BASE="${TMPDIR:-/tmp}"
  OPTIMIZE_TMPDIR="$TMP_BASE/optimize-$$-$RANDOM"
  mkdir -p "$OPTIMIZE_TMPDIR"
fi
REPO_CLONE_DIR="$OPTIMIZE_TMPDIR/repo"
NODE_SCRIPT="$OPTIMIZE_TMPDIR/$INSTALLER"
trap 'rm -rf "$OPTIMIZE_TMPDIR"' EXIT


# Always fetch installer script via curl from public URL
curl -fsSL "$INIT_PATH" -o "$NODE_SCRIPT"

# Fetch templates and skills from repo if needed (keep git logic if templates/skills are required)
git clone --depth 1 --filter=blob:none --sparse --branch "$BRANCH" "$REPO_URL" "$REPO_CLONE_DIR" > /dev/null 2>&1
cd "$REPO_CLONE_DIR"
git sparse-checkout init --cone
git sparse-checkout set templates skills
cd - > /dev/null

# Copy templates and skills to temp dir root for Node.js installer compatibility
cp -r "$REPO_CLONE_DIR/templates" "$OPTIMIZE_TMPDIR/templates"
cp -r "$REPO_CLONE_DIR/skills" "$OPTIMIZE_TMPDIR/skills"


# Run the Node.js installer, passing the temp dir so it doesn't clone again
export OPTIMIZE_TMPDIR
export REPO_CLONE_DIR

# Use /dev/tty to ensure prompts work even if stdin is redirected
node "$NODE_SCRIPT" < /dev/tty